    <!-- Three.js initialization for hero scene -->
    <script type="module">
      import * as THREE from 'https://unpkg.com/three@0.187.0/build/three.module.js';

      // Only initialize on desktop (not data-saver, not phones, not reduced motion)
      function shouldInitializeThreeJS() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return false;
        }
        // Check for data-saver preference
        if (navigator.connection && navigator.connection.saveData) {
          return false;
        }
        // Check viewport width - only on desktop
        if (window.innerWidth < 768) {
          return false;
        }
        return true;
      }

      if (shouldInitializeThreeJS()) {
        document.addEventListener('DOMContentLoaded', () => {
          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
          camera.position.z = 15;

          const renderer = new THREE.WebGLRenderer({ antialias: true });
          renderer.setSize(window.innerWidth, window.innerHeight);
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          document.getElementById('hero-threejs').appendChild(renderer.domElement);

          // Low-poly ground
          const groundGeometry = new THREE.PlaneGeometry(30, 30, 32, 32);
          const groundMaterial = new THREE.MeshStandardMaterial({ color: 0x0a1929, roughness: 0.8 });
          const ground = new THREE.Mesh(groundGeometry, groundMaterial);
          ground.rotation.x = -Math.PI / 2;
          scene.add(ground);

          // Low-poly buildings/towers for Twin Cities feel
          const buildingCount = 15;
          for (let i = 0; i < buildingCount; i++) {
            const geometry = new THREE.BoxGeometry(
              1 + Math.random() * 2,
              3 + Math.random() * 5,
              1 + Math.random() * 2
            );
            const material = new THREE.MeshStandardMaterial({
              color: new THREE.Color().setHSL(0.55, 0.5, 0.15 + Math.random() * 0.1),
              roughness: 0.6,
            });
            const building = new THREE.Mesh(geometry, material);
            building.position.set(
              -12 + Math.random() * 24,
              0,
              -10 + Math.random() * 20
            );
            building.scale.set(0.8 + Math.random() * 0.4, 1, 0.8 + Math.random() * 0.4);
            scene.add(building);
          }

          // Ambient light
          const ambientLight = new THREE.AmbientLight(0x2a4a6e, 0.5);
          scene.add(ambientLight);

          // Directional light - moon
          const dirLight = new THREE.DirectionalLight(0x4a90e2, 0.3);
          dirLight.position.set(5, 10, 7);
          scene.add(dirLight);

          // Slow rotation only (no scroll interaction)
          function animate() {
            requestAnimationFrame(animate);

            ground.rotation.y += 0.002;

            renderer.render(scene, camera);
          }

          animate();

          // Resize handler
          window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
          });
        });
      }
    </script>
