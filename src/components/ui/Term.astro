---
/* Renders a business term from src/config/offer.ts. Unapproved terms get a visible Placeholder tag. */
import type { Term } from '../../config/offer';
interface Props {
  term: Term;
  as?: 'span' | 'strong';
  nowrap?: boolean;
  /* Punctuation that belongs to the sentence: kept inside the chip so it never strands after the tag. */
  suffix?: string;
}
const { term, as: Tag = 'span', nowrap = false, suffix = '' } = Astro.props;
---
<Tag class:list={['term', { 'term--pending': !term.approved, 'term--nowrap': nowrap }]} data-pending={!term.approved ? 'true' : undefined}>
  {term.value}{suffix}{!term.approved && <span class="term__tag" title="Not approved by Tyler yet">Placeholder</span>}
</Tag>

<style>
  .term--pending {
    margin-inline: 0.2em;
    outline: 1.5px dashed var(--c-flag);
    outline-offset: 2px;
    border-radius: 3px;
  }
  .term--nowrap {
    white-space: nowrap;
  }
  .term__tag {
    display: inline-block;
    margin-left: 0.4em;
    padding: 0.1em 0.4em;
    border-radius: 4px;
    background: var(--c-flag-tint);
    color: var(--c-flag);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
    vertical-align: 0.15em;
    white-space: nowrap;
  }
</style>
