---
/*
  The hero's signature moment: an example after-hours call playing out, from ring to booked job.
  All data is invented and labeled as an example. Neutral on who answers (AL-1 open).
*/
import Icon from '../ui/Icon.astro';
---
<figure class="call" data-call aria-label="Example: an after-hours call that ends in a booked job">
  <div class="call__top">
    <span class="call__time"><Icon name="moon" size={16} /> Tue 2:14 a.m.</span>
    <span class="call__label">Example</span>
  </div>

  <ol class="call__feed">
    <li class="row row--ring" style="--i: 0">
      <span class="row__icon row__icon--ring"><Icon name="phone" size={18} /></span>
      <div>
        <p class="row__title">Incoming call</p>
        <p class="row__meta num">(651) 555-0148</p>
      </div>
    </li>
    <li class="row" style="--i: 1">
      <span class="row__icon"><Icon name="message" size={18} /></span>
      <div>
        <p class="row__quote">"Water is coming through my kitchen ceiling."</p>
      </div>
    </li>
    <li class="row" style="--i: 2">
      <span class="row__icon"><Icon name="pin" size={18} /></span>
      <div>
        <p class="row__title">Address read back</p>
        <p class="row__meta">Caller confirms it is right</p>
      </div>
    </li>
    <li class="row row--booked" style="--i: 3">
      <span class="row__icon row__icon--ok"><Icon name="check" size={18} /></span>
      <div>
        <p class="row__title">Job booked</p>
        <p class="row__meta num">Leak repair, Tue 7:30 a.m.</p>
      </div>
    </li>
  </ol>

  <div class="call__sms" style="--i: 4">
    <p class="call__sms-from">Text to you, 2:19 a.m.</p>
    <p class="call__sms-body">New job booked: leak repair, St. Paul, Tue 7:30 a.m. Address confirmed.</p>
  </div>
  <figcaption class="visually-hidden">An example call, not a real customer.</figcaption>
</figure>

<script>
  // The call plays when the card comes into view. Without JS, or with reduced motion, it is shown complete.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-playing');
          io.unobserve(e.target);
        }
      },
      { threshold: 0.35 },
    );
    document.querySelectorAll<HTMLElement>('[data-call]').forEach((card) => {
      card.classList.add('is-armed');
      io.observe(card);
    });
  }
</script>

<style>
  .call {
    --step: 520ms;
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 400px;
    padding: var(--s-5);
    border-radius: 28px;
    background:
      radial-gradient(120% 70% at 100% 0%, rgba(255, 107, 0, 0.16), transparent 60%),
      linear-gradient(180deg, var(--c-night-2), var(--c-night));
    color: #e8edf6;
    box-shadow: var(--shadow-3);
    isolation: isolate;
  }
  .call__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--s-5);
    font-size: var(--fs-small);
    color: #b9c3d6;
  }
  .call__time {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }
  .call__label {
    padding: 0.15rem 0.55rem;
    border-radius: var(--r-pill);
    background: rgba(167, 139, 250, 0.18);
    color: #c4b5fd;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .call__feed {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 36px 1fr;
    align-items: start;
    gap: var(--s-3);
  }
  .call.is-armed .row,
  .call.is-armed .call__sms {
    opacity: 0;
  }
  .call.is-playing .row {
    animation: row-in 600ms var(--ease-out) both;
    animation-delay: calc(var(--i) * var(--step) + 150ms);
  }
  .call.is-playing .call__sms {
    animation: sms-in 700ms var(--ease-out) both;
    animation-delay: calc(var(--i) * var(--step) + 300ms);
  }
  .row__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #c9d4e8;
  }
  .row__icon--ring {
    background: #2c4370;
    color: #fff;
  }
  .call.is-playing .row__icon--ring {
    animation: ring 1.1s var(--ease-out) 2 150ms;
  }
  .row__icon--ok {
    background: var(--c-accent);
    color: var(--c-cta-ink);
  }
  .row__title {
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
  }
  .row__meta {
    font-size: var(--fs-small);
    color: #b9c3d6;
  }
  .row__quote {
    padding: 0.55rem 0.8rem;
    border-radius: 14px 14px 14px 4px;
    background: rgba(255, 255, 255, 0.08);
    color: #e8edf6;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .row--booked .row__title {
    color: #ffa766;
  }
  .call__sms {
    margin-top: var(--s-5);
    padding: var(--s-4);
    border-radius: 16px;
    background: #fff;
    color: var(--c-ink);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }
  .call__sms-from {
    margin-bottom: 0.2rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--c-muted);
  }
  .call__sms-body {
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  @keyframes sms-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes ring {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(120, 160, 230, 0.5);
    }
    60% {
      box-shadow: 0 0 0 12px rgba(120, 160, 230, 0);
    }
  }
</style>
