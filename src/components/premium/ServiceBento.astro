---
/*
  Home services as a bento grid (cinematic upgrade): the website, which most owners start with, is the wide
  navy cell across the top; booking and answering sit below it. Each card lifts 2px under the mouse (Lift island).
  The whole card is the link, as in LinkCards.
*/
import Icon from '../ui/Icon.astro';
import Lift from './Lift.tsx';
interface Item {
  path: string;
  title: string;
  summary: string;
}
const { items } = Astro.props as { items: Item[] };
const lead = '/website-design-minnesota/';
const ordered = [...items].sort((a, b) => Number(b.path === lead) - Number(a.path === lead));
---
<ul class="bento" data-premium="bento" role="list">
  {
    ordered.map((i, n) => (
      <li class:list={['bento__cell', { 'bento__cell--lead': n === 0 }]}>
        <Lift client:media="(pointer: fine)" className="lift-card">
          <a class="bento__card" href={i.path}>
            <strong class="bento__title">{i.title}</strong>
            <span class="bento__sum">{i.summary}</span>
            <span class="bento__go">
              Learn more <Icon name="arrow" size={16} />
            </span>
          </a>
        </Lift>
      </li>
    ))
  }
</ul>

<style>
  .bento {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bento__card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    height: 100%;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }
  .bento__title {
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
  }
  .bento__sum {
    color: var(--c-ink-2);
    line-height: 1.55;
  }
  .bento__go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    font-weight: 600;
  }
  .bento__cell--lead :global(.lift-card) {
    background: linear-gradient(160deg, var(--c-primary), var(--c-night));
    border-color: transparent;
    color: #fff;
  }
  .bento__cell--lead .bento__sum {
    color: rgba(255, 255, 255, 0.82);
  }
  .bento__cell--lead .bento__title {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* The website, where most owners start, takes the whole first row; booking and answering share the second. */
    .bento__cell--lead {
      grid-column: 1 / -1;
    }
  }
</style>
