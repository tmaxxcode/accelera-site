---
/* Linked cards to other pages (services, trades). The whole card is the link. */
import Icon from '../ui/Icon.astro';
interface Item {
  path: string;
  title: string;
  summary: string;
  /* Optional sourced figure for this card. */
  fact?: { value: string; label: string; source: string };
}
interface Props {
  items: Item[];
  cols?: 2 | 3 | 4;
}
const { items, cols = 3 } = Astro.props;
---
<ul class:list={['cards', `cards--${cols}`]} role="list">
  {
    items.map((i) => (
      <li>
        <a class="card" href={i.path}>
          <strong>{i.title}</strong>
          {i.fact && (
            <span class="card__fact">
              <b class="num">{i.fact.value}</b> {i.fact.label} <small>{i.fact.source}</small>
            </span>
          )}
          <span>{i.summary}</span>
          <span class="card__go">
            Learn more <Icon name="arrow" size={16} />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    height: 100%;
    padding: var(--s-5);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: #fff;
    color: var(--c-ink);
    text-decoration: none;
    transition:
      border-color 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out),
      translate 200ms var(--ease-out);
  }
  .card:hover {
    border-color: var(--c-primary);
    box-shadow: var(--shadow-2);
    translate: 0 -2px;
    color: var(--c-ink);
  }
  .card strong {
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .card span {
    color: var(--c-ink-2);
    line-height: 1.5;
  }
  .card .card__fact {
    display: block;
    padding: var(--s-3) 0;
    border-block: 1px solid var(--c-line);
    color: var(--c-ink);
    font-size: 0.9375rem;
  }
  .card__fact b {
    display: block;
    font-size: 1.75rem;
    line-height: 1.1;
    letter-spacing: var(--track-display);
    color: var(--c-primary);
  }
  .card__fact small {
    display: block;
    margin-top: 0.15rem;
    color: var(--c-muted);
    font-size: 0.8125rem;
  }
  .card .card__go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: var(--s-2);
    color: var(--c-accent-ink);
    font-weight: 600;
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cards--3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .cards--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
