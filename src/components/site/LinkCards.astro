---
/* Linked cards to other pages (services, trades). The whole card is the link. */
import Icon from '../ui/Icon.astro';
interface Props {
  items: { path: string; title: string; summary: string }[];
  cols?: 2 | 3 | 4;
}
const { items, cols = 3 } = Astro.props;
---
<ul class:list={['cards', `cards--${cols}`]} role="list">
  {
    items.map((i) => (
      <li>
        <a class="card" href={i.path}>
          <strong>{i.title}</strong>
          <span>{i.summary}</span>
          <span class="card__go">
            Learn more <Icon name="arrow" size={16} />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: grid;
    gap: var(--s-2);
    height: 100%;
    padding: var(--s-5);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: #fff;
    color: var(--c-ink);
    text-decoration: none;
    transition:
      border-color 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out),
      translate 200ms var(--ease-out);
  }
  .card:hover {
    border-color: var(--c-primary);
    box-shadow: var(--shadow-2);
    translate: 0 -2px;
    color: var(--c-ink);
  }
  .card strong {
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .card span {
    color: var(--c-ink-2);
    line-height: 1.5;
  }
  .card .card__go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--s-2);
    color: var(--c-accent-ink);
    font-weight: 600;
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cards--3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .cards--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
