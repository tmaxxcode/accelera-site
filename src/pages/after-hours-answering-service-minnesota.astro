---
/* Neutral on who answers (MASTER AL-1 open): no "live person" or "AI" claims anywhere on this page. */
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Section from '../components/site/Section.astro';
import Checklist from '../components/site/Checklist.astro';
import FaqList from '../components/site/FaqList.astro';
import LinkCards from '../components/site/LinkCards.astro';
import CallCard from '../components/lp/CallCard.astro';
import ProofBar from '../components/lp/ProofBar.astro';
import Calculator from '../components/lp/Calculator.astro';
import AuditForm from '../components/lp/AuditForm.astro';
import Term from '../components/ui/Term.astro';
import { pages } from '../config/site';
import { prices, terms } from '../config/offer';
import { stats } from '../config/stats';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../config/schema';

const path = '/after-hours-answering-service-minnesota/';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'After-hours answering', path }];
const faq = [
  {
    q: 'Does this replace the person who answers my phone now?',
    a: 'No. They keep the hours they work now. We cover the rest: nights, weekends and holidays.',
  },
  {
    q: 'What happens to the caller’s details?',
    a: 'The address gets read back to the caller and confirmed. The job goes on your calendar, and you get a text.',
  },
  {
    q: 'Why not just use voicemail?',
    a: 'Under 3% of callers who reach voicemail leave a message, according to Invoca. The rest are gone before you can call back.',
  },
];
const site = Astro.site!;
---
<SiteLayout
  title="After-Hours Answering Service for Minnesota Trades | Accelera"
  description="After-hours call answering for Twin Cities trades. Calls get answered nights, weekends and holidays, and the job gets booked."
  schema={[
    serviceSchema(site, 'After-hours call answering for trades', 'Calls answered nights, weekends and holidays, with the job booked to the calendar and a text to the owner.', path),
    breadcrumbSchema(site, crumbs),
    faqSchema(faq),
  ]}
>
  <PageHero object="phone"
    title="After-hours answering for Minnesota trades"
    lead="Calls get answered nights, weekends and holidays. The address gets read back, the job lands on your calendar, and you get a text."
    crumbs={crumbs}
  >
    <CallCard />
  </PageHero>

  <ProofBar items={[stats.unanswered, stats.voicemail, stats.bookOnCall]} screen={false} />

  <Section id="daytime" title="You keep the daytime. We cover the rest." layout="split" tone="card">
    <div class="prose">
      <p>Whoever answers your phone today keeps doing it. They know your customers.</p>
      <p>We cover the hours they are off. That is when burst pipes, storm leaks and no-start cars still call.</p>
    </div>
    <Checklist
      items={['Nights, weekends and holidays', 'The address read back and confirmed', 'The job on your calendar', 'A text to you for every booked job']}
    />
    <ul class="note" role="list">
      <li>Price: <Term term={prices.answering} /></li>
      <li><Term term={terms.guarantee} /></li>
      <li><a href="/pricing/">See pricing and payment terms</a></li>
    </ul>
  </Section>

  <Calculator screen={false} />

  <Section id="questions" title="Questions owners ask" layout="split">
    <FaqList items={faq} name="answering" />
  </Section>

  <Section id="more" title="Pairs well with" tone="card">
    <LinkCards items={pages.filter((p) => p.group === 'service' && p.path !== path)} cols={2} />
  </Section>

  <AuditForm />
</SiteLayout>

<style>
  .note {
    display: grid;
    gap: var(--s-2);
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
    color: var(--c-ink-2);
    line-height: 1.6;
  }
  .note a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
  }
  :global(#daytime .prose) {
    margin-bottom: var(--s-5);
  }
</style>
