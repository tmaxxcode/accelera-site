---
import SiteLayout from '../layouts/SiteLayout.astro';
import SceneHero from '../components/site/SceneHero.astro';
import ProofBar from '../components/lp/ProofBar.astro';
import CallCard from '../components/lp/CallCard.astro';
import Calculator from '../components/lp/Calculator.astro';
import HowAndFaq from '../components/lp/HowAndFaq.astro';
import AuditForm from '../components/lp/AuditForm.astro';
import Section from '../components/site/Section.astro';
import ServiceBento from '../components/premium/ServiceBento.astro';
import TradeCards from '../components/premium/TradeCards.astro';
import { pages } from '../config/site';
import { stats } from '../config/stats';
import '../styles/homepage.css';

const proof = [stats.unanswered, stats.voicemail, stats.bookOnCall];
// Trade cards carry a sourced figure where one exists (99 Calls covers plumbers and roofers only).
const facts: Record<string, { value: string; label: string; source: string; url: string }> = {
  '/plumbers/': { value: stats.plumbersMissed.value, label: stats.plumbersMissed.label, source: '99 Calls study of 1,794 plumbing calls', url: stats.plumbersMissed.url },
  '/roofers/': { value: stats.roofers.value, label: stats.roofers.label, source: '99 Calls study of 3,604 roofing calls', url: stats.roofers.url },
};
const trades = pages.filter((p) => p.group === 'trade').map((p) => ({ ...p, fact: facts[p.path] }));
---
<SiteLayout
  title="Trade Websites, Booking and After-Hours Answering | Accelera"
  description="Accelera builds websites, online booking and after-hours call answering for plumbers, roofers, auto repair shops and contractors in the Twin Cities metro."
>
  <SceneHero
    headline="Every missed call is a job at risk."
    sub="We build your website, add easy booking, and help you catch the calls that come in after hours. You stay on the job. We make sure the next one gets booked."
    cta="Get a free missed-call audit"
  />
  <ProofBar items={proof}><CallCard /></ProofBar>

  <Section id="services" title="Three parts. Start with one." intro="Most owners start with the website. Add booking or after-hours answering when you want them." tone="card" screen>
    <ServiceBento items={pages.filter((p) => p.group === 'service')} />
  </Section>


  <Calculator />
  <Section id="trades" title="Built for the trades that get calls at night" layout="split" intro="The trades where a missed call is a lost job." screen>
    <TradeCards rows={trades} />
  </Section>
  <HowAndFaq />
  <AuditForm />
</SiteLayout>
