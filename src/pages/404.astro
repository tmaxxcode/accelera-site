---
import SiteLayout from '../layouts/SiteLayout.astro';
import Section from '../components/site/Section.astro';
import LinkCards from '../components/site/LinkCards.astro';
import { pages } from '../config/site';
---
<SiteLayout title="Page not found | Accelera" description="This page does not exist. Here is where to go instead.">
  <Section id="hero" title="That page is not here">
    <p class="lead">The link may be old or mistyped. These pages are a good place to start.</p>
    <LinkCards items={pages.filter((p) => p.group === 'service' || p.path === '/')} cols={4} />
  </Section>
</SiteLayout>

<style>
  .lead {
    margin-bottom: var(--s-5);
    font-size: 1.125rem;
    color: var(--c-ink-2);
  }
</style>
