---
/*
  /lp/trades — LONG variant, all-trades angle (Tyler 2026-11-15). noindex.
  A/B pair: /lp/trades-quick (short). Sections follow PLAN.md "Page anatomy".
*/
import LandingLayout from '../../layouts/LandingLayout.astro';
import Hero from '../../components/lp/Hero.astro';
import ProofBar from '../../components/lp/ProofBar.astro';
import Calculator from '../../components/lp/Calculator.astro';
import OfferStack from '../../components/lp/OfferStack.astro';
import BookingDemo from '../../components/lp/BookingDemo.astro';
import HowAndFaq from '../../components/lp/HowAndFaq.astro';
import CallCard from '../../components/lp/CallCard.astro';
import AuditForm from '../../components/lp/AuditForm.astro';
import StickyCta from '../../components/lp/StickyCta.astro';
import LpFooter from '../../components/lp/LpFooter.astro';
import { stats } from '../../config/stats';

const proof = [stats.unanswered, stats.voicemail, stats.bookOnCall];
---
<LandingLayout
  title="Never miss the 2 a.m. job | Accelera, Twin Cities"
  description="Website, online booking and after-hours call answering for Twin Cities plumbers, roofers, auto shops and contractors."
  variant="trades-long"
>
  <Hero
    headline="The phone rings at 2 a.m. The job still gets booked."
    sub="We give Twin Cities plumbers, roofers, auto shops and contractors a website, online booking and after-hours call answering. One local team sets it all up."
  >
    <ProofBar slot="foot" items={proof} embedded />
  </Hero>
  <ProofBar items={proof} class="hide-wide"><CallCard /></ProofBar>
  <Calculator />
  <OfferStack />
  <BookingDemo />
  <HowAndFaq />
  <AuditForm />
  <LpFooter sources={[...proof, stats.voicemail]} />
  <StickyCta slot="after" />
</LandingLayout>
