---
/* /lp/missed-calls — phone angle ad set (all trades). LONG layout. noindex. */
import LongLanding from '../../components/lp/LongLanding.astro';
import { stats } from '../../config/stats';
---
<LongLanding
  title="Stop losing jobs to missed calls | Accelera, Twin Cities"
  description="After-hours call answering, a website and online booking for Twin Cities trades."
  variant="missed-calls"
  headline="Your phone rings at 2 a.m. You wake up to a booked job."
  sub="Calls get answered nights, weekends and holidays. The job lands on your calendar and you get a text. For Twin Cities trades."
  proof={[stats.unanswered, stats.voicemail, stats.bookOnCall]}
/>
